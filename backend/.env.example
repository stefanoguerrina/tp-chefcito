# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.

# Obligatorias
# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="mysql://root:CONTRASEÑA@localhost:3306/chefcito"
# Clave con la que se firman las sesiones (JWT). Puede ser cualquier texto.
JWT_SECRET=cambiar-por-una-clave-propia

# Opcionales: servidor. En local no hace falta tocarlas; solo se usan en el deploy.
# Puerto de la API (por defecto 3000)
# PORT=3000
# Orígenes del frontend permitidos, separados por comas (por defecto los de Vite en local)
# CORS_ORIGINS=https://mi-frontend.com
# URL del frontend a la que vuelve Mercado Pago después de pagar (por defecto http://localhost:5173)
# FRONTEND_URL=https://mi-frontend.com

# Opcionales: Chefcito Bot (sin la clave, el chat responde que no está disponible)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Opcionales: fotos en Cloudinary (deploy). Con las tres cargadas, las fotos subidas se guardan
# en Cloudinary; sin ellas, en backend/uploads/ (lo normal en local). Están en el panel de
# Cloudinary (Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: donaciones (Access Token de prueba de Mercado Pago; sin él no se puede donar)
MERCADOPAGO_ACCESS_TOKEN=
